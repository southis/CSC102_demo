// -------------------------------------------------------

// Function: startDuel()

// Purpose: Runs the duel game when the form is submitted.

// -------------------------------------------------------

function startDuel() {



    // Get the player's chosen strength from the form input

    let playerStrength = Number(document.getElementById("playerStrength").value);



    // Random opponent strength between 1 and 100

    let opponentStrength = Math.floor(Math.random() * 100) + 1;



    // Call the second function to determine victory

    let message = determineOutcome(playerStrength, opponentStrength);



    // Output the results to the web page using innerHTML

    document.getElementById("results").innerHTML =

        "<strong>Your Strength:</strong> " + playerStrength + "<br>" +

        "<strong>Opponent Strength:</strong> " + opponentStrength + "<br><br>" +

        message;

}







// -------------------------------------------------------

// Function: determineOutcome(player, opponent)

// Purpose: Accepts two parameters and returns the duel result.

// -------------------------------------------------------

function determineOutcome(player, opponent) {



    // If your strength is greater, you win

    if (player > opponent) {

        return " Victory. You stood firm when it mattered.";

    }



    // If the opponent is stronger, you lose

    else if (player < opponent) {

        return " Defeat. Even the strongest fall when caution is ignored.";

    }



    // Equal strength – a perfect tie

    else {

        return " A tie. Two forces in perfect balance.";

    }

}
