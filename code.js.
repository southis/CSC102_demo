/* Function: playGame ()

Called when the form is submitted.

Uses random numbers, math, conditionals, and updates the page with innerHTML.

/*

function playGame () {

 // Get the player's strength from the HTML input field

    let playerStrength = parseInt(document.getElementById("playerStrength").value);



    // Generate a random opponent strength from 1–100

    let opponentStrength = Math.floor(Math.random() * 100) + 1;



    // Use the second function to calculate "duel intensity"

    let intensity = calculateIntensity(playerStrength);



    // Compare strengths to determine the winner

    let resultMessage = "";



    if (playerStrength > opponentStrength) {

        resultMessage = "<strong>You win!</strong> Your strength overpowered your opponent.";

    } 

    else if (playerStrength < opponentStrength) {

        resultMessage = "<strong>You lose!</strong> The opponent was stronger this time.";

    } 

    else {

        resultMessage = "<strong>It's a tie.</strong> Equal power met in the arena.";

    }



    // Add a tiny philosophical line (light & safe)

    let philosophy = `"Strength is revealed only when tested."`;



    // Output everything to the HTML page (REQUIREMENT)

document.getElementById("gameOutput").innerHTML =

        "<h3>Duel Results</h3>" +

        "Your Strength: " + playerStrength + "<br>" +

        "Opponent Strength: " + opponentStrength + "<br>" +

        "Duel Intensity: " + intensity + "<br><br>" +

        resultMessage + "<br><br>" +

        philosophy;



    // Return false so the form does NOT refresh the page

    return false;

}

/*
Function: calculateIntensity (value)
Accepts a parameter (player strength)
Performs a simple math equation
Returns the result
*/

function calculateIntensity(value) {

// Example calculation: intensity is 1.5x the player's strength

return value * 1.5;

}
 
